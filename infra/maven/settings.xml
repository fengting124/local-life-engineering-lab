<?xml version="1.0" encoding="UTF-8"?>
<!--
  Docker 构建专用 Maven settings —— 显式使用 Maven Central。

  动机：
    Docker Desktop 通过内部 HTTP 代理提供 DNS 和外网访问。实测同一 Maven 构件经
    Central 下载的握手和首字节时间明显低于阿里云镜像，因此默认使用 Central，避免
    ShardingSphere 大量细粒度 POM 在镜像代理上累积数十分钟额外延迟。

  作用范围：
    只镜像 <mirrorOf>central</mirrorOf>，不会拦截未来显式声明的第三方仓库。

  仅在镜像构建阶段使用（Dockerfile COPY 到 /root/.m2/settings.xml，Maven 自动读取），
  不影响开发者本机的 ~/.m2/settings.xml。
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              https://maven.apache.org/xsd/settings-1.0.0.xsd">
    <mirrors>
        <mirror>
            <id>central-direct</id>
            <name>Maven Central</name>
            <url>https://repo.maven.apache.org/maven2</url>
            <mirrorOf>central</mirrorOf>
        </mirror>
    </mirrors>
</settings>
