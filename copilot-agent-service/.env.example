# ================================================================
# LocalLife Copilot Agent Service — 环境变量模板
# 复制此文件为 .env，填写真实值后启动服务
# ================================================================

# ===== LLM 配置（选择一个 Provider，默认 DeepSeek）=====
# 不管选哪个 provider，统一填写 LLM_API_KEY / LLM_MODEL / LLM_BASE_URL。
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-v4-flash
# LLM_BASE_URL 留空时使用 provider 默认地址

# Anthropic Claude
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=claude-sonnet-4-6

# 通义千问
# LLM_PROVIDER=qwen
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=qwen-max
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 本地 Ollama
# LLM_PROVIDER=local
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434/v1

# ===== Java MCP Server 地址 =====
MCP_SERVER_URL=http://localhost:8081
MCP_CONTEXT_SIGNING_SECRET=local-life-mcp-context-secret

# ===== 数据库 =====
DB_URL=mysql+aiomysql://root:123456@localhost:3306/local_life

# ===== Redis =====
REDIS_URL=redis://localhost:6379/2

# ===== RAG 模型服务 =====
EMBEDDING_SERVICE_URL=http://localhost:8100
RERANKER_SERVICE_URL=http://localhost:8101

# ===== 向量存储 =====
VECTOR_BACKEND=milvus

# 本地默认：Milvus Lite，数据写入本地文件，无需 etcd / MinIO / Milvus Server。
MILVUS_URI=./data/local_life_kb.db

# 完整部署：改成 Standalone Endpoint。HOST/PORT 仅保留旧配置兼容。
# MILVUS_URI=http://localhost:19530
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
MILVUS_COLLECTION=local_life_kb

# Embedding 模型必须与 embedding-service 配置一致
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_DIMENSION=768

# RAG 检索参数
RAG_TOP_K_RECALL=20
RAG_TOP_K_RERANK=5
RAG_MIN_SCORE=0.3
RAG_TIMEOUT_SECONDS=10

# ===== Agent 参数 =====
AGENT_MAX_STEPS=15
SESSION_TOKEN_BUDGET=50000
REFLECTION_INTERVAL=5

# ===== 服务端口 =====
APP_PORT=8000
DEBUG=true

# ===== Web / CORS =====
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
